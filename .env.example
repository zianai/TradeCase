# Workbench safe defaults. Copy to an ignored env file and load explicitly.
# No real API key/password belongs in this template.
TRADECASE_DATABASE_URL=sqlite:///.tradecase/platform.db
TRADECASE_CHECKPOINT_URL=sqlite:///.tradecase/checkpoints.sqlite
TRADECASE_REDIS_URL=redis://localhost:6379/0
TRADECASE_QUEUE_MODE=local
TRADECASE_RUNTIME=fake
TRADECASE_LIVE_MODEL_ENABLED=false
TRADECASE_DEMO_ENABLED=false
TRADECASE_OUTBOUND_ENABLED=false
TRADECASE_MAIL_CONNECTOR=disabled
TRADECASE_PUBLIC_FETCH_ENABLED=false
TRADECASE_RESEARCH_DOMAINS=
TRADECASE_MAX_CASE_COST_USD=0.10
# TRADECASE_MODEL and TRADECASE_USD_PER_TOKEN_UPPER_BOUND require an operator-verified model/rate.
TRADECASE_SKILLS_ROOT=skills
TRADECASE_API_URL=http://127.0.0.1:8800
TRADECASE_PORT=8800
# Production: PostgreSQL + Redis/ARQ + HTTPS reverse proxy; see docs/WORKBENCH_DEPLOYMENT.md.
# Optional SMTP secrets only through your secret manager, never source control.

TRADECASE_STORAGE_BACKEND=local
# S3 only when explicitly configured; AWS credentials stay in your secret manager.
# TRADECASE_S3_BUCKET=your-private-bucket
# TRADECASE_S3_ENDPOINT_URL=https://your-s3-compatible-service
TRADECASE_S3_ENCRYPTION=AES256
