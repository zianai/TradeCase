{
  "$defs": {
    "AgentBudget": {
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "default": 4,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 8,
          "maximum": 50,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_wall_seconds": {
          "default": 90,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Max Wall Seconds",
          "type": "number"
        },
        "max_tool_seconds": {
          "default": 15,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Max Tool Seconds",
          "type": "number"
        },
        "max_total_tokens": {
          "default": 24000,
          "maximum": 200000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 2000,
          "maximum": 16000,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_cost_usd": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Cost Usd",
          "type": "number"
        },
        "max_calls_per_domain": {
          "default": 4,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Calls Per Domain",
          "type": "integer"
        },
        "min_domain_interval": {
          "default": 1,
          "maximum": 30,
          "minimum": 0,
          "title": "Min Domain Interval",
          "type": "number"
        }
      },
      "title": "AgentBudget",
      "type": "object"
    },
    "SourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "maxLength": 4096,
          "title": "Url",
          "type": "string"
        },
        "source_type": {
          "default": "website",
          "maxLength": 80,
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        },
        "captured_at": {
          "title": "Captured At",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 65536,
          "title": "Text",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "status": {
          "default": "fetched",
          "enum": [
            "fetched",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "gap_reason": {
          "default": "",
          "maxLength": 500,
          "title": "Gap Reason",
          "type": "string"
        },
        "is_synthetic": {
          "default": false,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "license_status": {
          "default": "unknown",
          "enum": [
            "permitted",
            "unknown",
            "unavailable"
          ],
          "title": "License Status",
          "type": "string"
        },
        "authority": {
          "default": "source_claim",
          "enum": [
            "source_claim",
            "user_provided_unverified"
          ],
          "title": "Authority",
          "type": "string"
        },
        "document_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Version"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "document_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Hash"
        }
      },
      "required": [
        "source_id",
        "url"
      ],
      "title": "SourceSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "case_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "task_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "agent_run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Agent Run Id",
      "type": "string"
    },
    "task_type": {
      "default": "identity_research",
      "maxLength": 100,
      "title": "Task Type",
      "type": "string"
    },
    "goal": {
      "maxLength": 2000,
      "title": "Goal",
      "type": "string"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "input_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Input Refs",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceSnapshot"
      },
      "maxItems": 50,
      "title": "Sources",
      "type": "array"
    },
    "allowed_tools": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Allowed Tools",
      "type": "array"
    },
    "allowed_domains": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Allowed Domains",
      "type": "array"
    },
    "skill_names": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Skill Names",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/AgentBudget"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "task_id",
    "agent_run_id",
    "goal"
  ],
  "title": "AgentTaskRequest",
  "type": "object"
}